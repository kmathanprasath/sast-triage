# ─────────────────────────────────────────
# VaultScan — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# PostgreSQL (defaults work for local development)
DB_USER=debtscan
DB_PASSWORD=debtscan123
DB_NAME=debtscan

# SonarQube token
# Get this from http://localhost:9000 → My Account → Security → Generate Token
# Required for SonarQube analysis. Without it, only Semgrep results are used.
SONAR_TOKEN=

# Gemini API key — enables AI-powered triage with cascade explanations
# Free tier available at https://aistudio.google.com/app/apikey
# Without this, VaultScan falls back to rule-based triage (still fully functional)
GEMINI_API_KEY=

# GitHub Personal Access Token
# Required only for scanning private GitHub repositories
# Needs: repo (read) scope
GITHUB_TOKEN=

# Semgrep configuration
# "auto" uses Semgrep's recommended rules for each language
# Alternatives: "p/security-audit", "p/owasp-top-ten", "p/javascript"
SEMGREP_RULES=auto

# Semgrep Cloud token (optional — for managed rulesets and Semgrep Cloud features)
SEMGREP_APP_TOKEN=

# Scheduled scanning
# Automatically re-scans all registered microservices on a cron schedule
SCAN_CRON_ENABLED=true
SCAN_CRON_SCHEDULE=0 3 * * *
